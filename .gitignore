# =============================================================================
# .gitignore
# =============================================================================
 
# Composer: dependencias instaladas localmente
# vendor/ se genera con "docker compose exec app composer install"
# En producción se sube via GitHub Actions (ver workflow)
vendor/
 
# Fichero de configuración local de PHPUnit (sobreescribe phpunit.xml.dist)
phpunit.xml
 
# Secretos y configuración local
private/.env
 
# Datos históricos locales (JSONs de semanas, NDJSONs generados)
# Estos no van al repo: pueden ser grandes y son datos reales de dispositivos
private/storage/
 
# Storage local de desarrollo (los JSON de semanas históricas sí van al repo
# porque los necesitamos para el importador histórico, pero los generados no)
storage/bridge_logs_*.ndjson
 
# IDEs y editores
.idea/
.vscode/
*.swp
*.swo
*~
 
# macOS
.DS_Store
.AppleDouble
.LSOverride
 
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
 
# Logs de PHP locales
*.log