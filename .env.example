# Copy this file to .env on the server if the hosting setup supports it.
# Do not commit real credentials.

APP_ENV=production
APP_URL=https://logs.singularthings.io

# Current production ingest secret must stay compatible with deployed devices.
LOG_INGEST_SECRET=change-me
LOG_INGEST_USER_AGENT=WalkerPisa-Bridge-Logs

# Future private viewer credentials.
VIEWER_USER=admin
VIEWER_PASSWORD=change-me

# Admin maintenance endpoint for reprocessing stored ingests.
# Keep disabled by default in production. Enable only when needed.
REPROCESS_ENABLED=false
ADMIN_REPROCESS_TOKEN=change-me-admin-token

# Viewer authentication.
# The dashboard is protected by PHP-level HTTP Basic auth.
VIEWER_AUTH_ENABLED=true
VIEWER_AUTH_USERNAME=admin
VIEWER_AUTH_PASSWORD=change-me-viewer-password

# GitHub Actions FTP deploy secrets are configured in GitHub, not here:
# FTP_SERVER
# FTP_USERNAME
# FTP_PASSWORD
# FTP_TARGET_DIR
