Options -Indexes

RewriteEngine On
RewriteBase /

# Preserve Authorization header for PHP-FPM / FastCGI environments.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# -----------------------------------------------------------------------------
# Bloqueo de acceso directo a /public.
#
# Los rewrites internos sí pueden resolver a public/*.php, pero una petición
# externa como /public/index.php o /public/api/health.php queda prohibida.
# THE_REQUEST contiene la URL original pedida por el cliente, no el destino
# interno del rewrite.
# -----------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+public(?:/|\s) [NC]
RewriteRule ^public(?:/|$) - [F,L,NC]

# -----------------------------------------------------------------------------
# Bloqueo de directorios no públicos.
# Aunque el hosting sirva este subdirectorio como raíz del subdominio, estas
# carpetas nunca deben poder descargarse por HTTP.
# -----------------------------------------------------------------------------
RewriteRule ^services/logs/storage(?:/|$) - [F,L,NC]
RewriteRule ^(?:src|vendor|storage|scripts|docs|tests|private|logs-notifications)(?:/|$) - [F,L,NC]

# Bloqueo de dotfiles: .git, .env, .htaccess, .phpunit.result.cache,
# .ftp-deploy-sync-state.json, etc.
RewriteRule (^|/)\. - [F,L]

# Bloqueo de ficheros sensibles o huérfanos en raíz.
RewriteRule ^(?:composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|docker-compose\.ya?ml|README\.md|home\.html)$ - [F,L,NC]

# -----------------------------------------------------------------------------
# Whitelist defensiva.
#
# Permitimos:
# - Rutas públicas externas.
# - Endpoints API externos.
# - Endpoint legacy de bridges.
# - Destinos internos public/... necesarios para que funcionen los rewrites.
#
# Todo lo demás devuelve 403.
# -----------------------------------------------------------------------------
RewriteRule !^(?:$|index\.php|devices\.php|device\.php|events\.php|event\.php|ingests\.php|ingest\.php|api/(?:ingest|health)\.php|api/admin/(?:reprocess|archive_raw|import_services_logs)\.php|services/logs/index\.php|public/(?:index|devices|device|events|event|ingests|ingest)\.php|public/api/(?:ingest|health)\.php|public/api/admin/(?:reprocess|archive_raw|import_services_logs)\.php)$ - [F,L,NC]

# -----------------------------------------------------------------------------
# Rutas públicas del visor.
# Se usan rewrites internos: la URL externa no cambia.
# QSA conserva query strings como /device.php?id=123.
# -----------------------------------------------------------------------------
RewriteRule ^$ public/index.php [L,QSA]
RewriteRule ^index\.php$ public/index.php [L,QSA]

RewriteRule ^devices\.php$ public/devices.php [L,QSA]
RewriteRule ^device\.php$ public/device.php [L,QSA]
RewriteRule ^events\.php$ public/events.php [L,QSA]
RewriteRule ^event\.php$ public/event.php [L,QSA]
RewriteRule ^ingests\.php$ public/ingests.php [L,QSA]
RewriteRule ^ingest\.php$ public/ingest.php [L,QSA]

# -----------------------------------------------------------------------------
# Endpoints API.
# -----------------------------------------------------------------------------
RewriteRule ^api/ingest\.php$ public/api/ingest.php [L,QSA]
RewriteRule ^api/health\.php$ public/api/health.php [L,QSA]
RewriteRule ^api/admin/reprocess\.php$ public/api/admin/reprocess.php [L,QSA]
RewriteRule ^api/admin/archive_raw\.php$ public/api/admin/archive_raw.php [L,QSA]
RewriteRule ^api/admin/import_services_logs\.php$ public/api/admin/import_services_logs.php [L,QSA]

# Cualquier otra ruta queda bloqueada por la whitelist defensiva anterior.